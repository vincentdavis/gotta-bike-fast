{
	admin off
	# Railway terminates TLS at its edge; serve plain HTTP on $PORT internally.
	auto_https off
}

:{$PORT} {
	root * /srv
	# Railway's deploy health check (healthcheckPath in railway.json).
	respond /healthz "ok" 200
	# Serve the precompressed *.gz (wasm/pck/js) when the client accepts gzip.
	file_server {
		precompressed gzip
	}
	# WebAssembly must carry Content-Type: application/wasm (even gzip-encoded)
	# so the browser can stream-compile it.
	@wasm path *.wasm
	header @wasm Content-Type application/wasm
	# Assets aren't content-hashed, so browsers must revalidate every load
	# (a cheap 304 via the ETag): a cached older build would otherwise keep
	# running for a while after a deploy, e.g. ignoring the website's Play
	# sign-in handoff.
	header Cache-Control "no-cache"
}
